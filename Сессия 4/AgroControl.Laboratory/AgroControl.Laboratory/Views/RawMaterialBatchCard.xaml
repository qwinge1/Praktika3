<Window x:Class="AgroControl.Laboratory.Views.RawMaterialBatchCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка партии сырья" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F3F4F6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding НомерПартии}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding Поставщик}" />
                <TextBlock Text="Дата поступления: {Binding ДатаПоступления, StringFormat=dd.MM.yyyy}" />
                <TextBlock Text="Количество, кг: {Binding Количество_кг}" />
                <TextBlock Text="Статус: {Binding ЛабораторныйСтатус}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Проведённые испытания" FontWeight="Bold" Margin="0,0,0,5"/>
        <DataGrid x:Name="testsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="TestsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Тип образца" Binding="{Binding ТипОбразца}" Width="120"/>
                <DataGridTextColumn Header="Дата анализа" Binding="{Binding ДатаАнализа, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Параметр" Binding="{Binding НаименованиеПараметра}" Width="150"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Результат}" Width="80"/>
                <DataGridTextColumn Header="Решение" Binding="{Binding Решение}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Лабораторное решение" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="approveRadio" Content="Разрешить использование" GroupName="Decision" Margin="0,0,15,0"/>
                    <RadioButton x:Name="blockRadio" Content="Заблокировать" GroupName="Decision"/>
                </StackPanel>
                <TextBox x:Name="commentBox" Margin="0,8,0,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                         ToolTip="Комментарий (обязательно при блокировке)"/>
                <Button Content="Принять решение" Click="MakeDecision_Click" Width="150" Style="{StaticResource PrimaryButton}"/>
                <TextBlock x:Name="decisionError" Foreground="Red" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>