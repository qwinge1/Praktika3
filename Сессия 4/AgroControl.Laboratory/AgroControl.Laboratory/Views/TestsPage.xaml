<UserControl x:Class="AgroControl.Laboratory.Views.TestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AgroControl.Laboratory.Converters"
             Background="#F9FAFB">
    <UserControl.Resources>
        <conv:StatusToTextColorConverter x:Key="StatusToTextColorConverter"/>
        <conv:TestResultToColorConverter x:Key="TestResultToColorConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Click="Refresh_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Создать испытание" Click="CreateTest_Click" Width="150" Background="#10B981" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
            <Button Content="Редактировать" Click="EditTest_Click" Width="120" Background="#F59E0B" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
            <Button Content="Удалить" Click="DeleteTest_Click" Width="100" Background="#DC2626" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="searchBox" Width="200" Margin="0,0,10,0"/>
            <Button Content="Искать" Click="Search_Click" Width="80" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Сброс" Click="ClearSearch_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </WrapPanel>

        <DataGrid x:Name="testsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  AlternatingRowBackground="#F9FAFB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ТипОбразца}" Width="Auto"/>
                <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Параметр" Binding="{Binding НаименованиеПараметра}" Width="Auto"/>
                <DataGridTextColumn Header="Норматив" Binding="{Binding НормативноеЗначение}" Width="Auto"/>
                <DataGridTextColumn Header="Измерено" Binding="{Binding ИзмеренноеЗначение}" Width="Auto"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Результат}" Width="Auto" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Результат, Converter={StaticResource TestResultToColorConverter}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Решение" Binding="{Binding Решение}" Width="Auto"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Статус}" Width="Auto" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Статус, Converter={StaticResource StatusToTextColorConverter}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>