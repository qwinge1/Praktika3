<Window x:Class="AgroControl.Laboratory.Views.ProductBatchCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка партии готовой продукции" Height="750" Width="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Основная информация -->
        <Border Background="#F3F4F6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding НомерПартии}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Статус производства: {Binding Статус}" />
                <TextBlock Text="Лабораторный статус: {Binding ЛабораторныйСтатус}" />
                <TextBlock Text="Дата старта: {Binding ВремяСтарта, StringFormat=dd.MM.yyyy HH:mm}" />
                <TextBlock Text="Дата окончания: {Binding ВремяОкончания, StringFormat=dd.MM.yyyy HH:mm}" />
                <TextBlock Text="Факт количество, кг: {Binding ФактКоличество_кг}" />
            </StackPanel>
        </Border>

        <!-- Кнопки управления испытаниями -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Новое испытание" Click="AddTest_Click" Width="120" Background="#10B981" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Редактировать" Click="EditTest_Click" Width="120" Background="#F59E0B" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
            <Button Content="Удалить испытание" Click="DeleteTest_Click" Width="140" Background="#DC2626" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
            <Button Content="Обновить список" Click="RefreshTests_Click" Width="120" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Список испытаний -->
        <DataGrid x:Name="testsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="TestsGrid_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ТипОбразца}" Width="100"/>
                <DataGridTextColumn Header="Дата назначения" Binding="{Binding ДатаНазначения, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding Исполнитель.ПолноеИмя}" Width="150"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Приоритет}" Width="80"/>
                <DataGridTextColumn Header="Параметр" Binding="{Binding НаименованиеПараметра}" Width="120"/>
                <DataGridTextColumn Header="Норматив" Binding="{Binding НормативноеЗначение}" Width="80"/>
                <DataGridTextColumn Header="Измерено" Binding="{Binding ИзмеренноеЗначение}" Width="80"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Результат}" Width="80"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Статус}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Блок решения с историей -->
        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Лабораторное решение" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="approveRadio" Content="Одобрить" GroupName="Decision" Margin="0,0,15,0"/>
                    <RadioButton x:Name="blockRadio" Content="Заблокировать" GroupName="Decision"/>
                </StackPanel>
                <TextBox x:Name="commentBox" Margin="0,8,0,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                         ToolTip="Комментарий (обязательно при блокировке)"/>
                <Button Content="Принять решение" Click="MakeDecision_Click" Width="150" Style="{StaticResource PrimaryButton}"/>
                <TextBlock x:Name="decisionError" Foreground="Red" Margin="0,5,0,0"/>

                <!-- История решений -->
                <TextBlock Text="История решений" FontWeight="Bold" Margin="0,15,0,5"/>
                <ItemsControl x:Name="historyItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>