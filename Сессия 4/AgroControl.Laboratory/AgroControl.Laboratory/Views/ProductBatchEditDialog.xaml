<Window x:Class="AgroControl.Laboratory.Views.ProductBatchEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование партии готовой продукции" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Номер партии:" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" x:Name="batchNumberBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Text="Статус производства:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="statusCombo" Margin="0,0,0,5">
            <ComboBoxItem Content="запланирована"/>
            <ComboBoxItem Content="выполняется"/>
            <ComboBoxItem Content="завершена"/>
            <ComboBoxItem Content="заблокирована"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Факт количество, кг:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="quantityBox" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="Save_Click" Width="75" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="75" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>