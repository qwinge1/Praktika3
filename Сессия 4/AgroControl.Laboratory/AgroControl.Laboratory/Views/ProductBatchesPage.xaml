<UserControl x:Class="AgroControl.Laboratory.Views.ProductBatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AgroControl.Laboratory.Converters"
             Background="#F9FAFB">
    <UserControl.Resources>
        <conv:StatusToTextColorConverter x:Key="StatusToTextColorConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Click="Refresh_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Поиск по номеру:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="searchBox" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="Статус производства:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="statusFilter" Width="140" Margin="0,0,10,0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="запланирована"/>
                <ComboBoxItem Content="выполняется"/>
                <ComboBoxItem Content="завершена"/>
                <ComboBoxItem Content="заблокирована"/>
            </ComboBox>
            <TextBlock Text="Лаб. статус:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="labStatusFilter" Width="120" Margin="0,0,10,0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="ожидает"/>
                <ComboBoxItem Content="одобрена"/>
                <ComboBoxItem Content="заблокирована"/>
            </ComboBox>
            <Button Content="Применить" Click="ApplyFilters_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Сброс" Click="ClearFilters_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </WrapPanel>

        <DataGrid x:Name="batchesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="BatchesGrid_SelectionChanged"
                  AlternatingRowBackground="#F9FAFB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto"/>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding НомерПартии}" Width="Auto"/>
                <DataGridTextColumn Header="Статус производства" Binding="{Binding Статус}" Width="Auto"/>
                <DataGridTextColumn Header="Лаб. статус" Binding="{Binding ЛабораторныйСтатус}" Width="Auto" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding ЛабораторныйСтатус, Converter={StaticResource StatusToTextColorConverter}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата старта" Binding="{Binding ВремяСтарта, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                <DataGridTextColumn Header="Кол-во, кг" Binding="{Binding ФактКоличество_кг}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>