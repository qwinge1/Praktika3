<UserControl x:Class="AgroControl.Laboratory.Views.RawMaterialBatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Click="Refresh_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Создать испытание" Click="CreateTest_Click" Width="150" Background="#10B981" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox x:Name="searchBox" Width="200" Margin="6,0,6,0"/>
            <Button Content="Искать" Click="Search_Click" Width="80" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Сброс" Click="ClearSearch_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="batchesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="BatchesGrid_SelectionChanged"
                  AlternatingRowBackground="#F9FAFB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding НомерПартии}" Width="150"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Поставщик}" Width="150"/>
                <DataGridTextColumn Header="Дата поступления" Binding="{Binding ДатаПоступления, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Кол-во, кг" Binding="{Binding Количество_кг}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding ЛабораторныйСтатус}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>