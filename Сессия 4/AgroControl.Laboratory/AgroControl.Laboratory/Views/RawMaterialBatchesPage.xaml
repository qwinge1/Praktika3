<UserControl x:Class="AgroControl.Laboratory.Views.RawMaterialBatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AgroControl.Laboratory.Converters"
             Background="#F9FAFB">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Click="Refresh_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="searchBox" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="statusFilter" Width="120" Margin="0,0,10,0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="ожидает"/>
                <ComboBoxItem Content="в работе"/>
                <ComboBoxItem Content="одобрена"/>
                <ComboBoxItem Content="заблокирована"/>
            </ComboBox>
            <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="supplierFilter" Width="150" Margin="0,0,10,0"/>
            <TextBlock Text="Дата от:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dateFrom" Width="110" Margin="0,0,10,0"/>
            <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dateTo" Width="110" Margin="0,0,10,0"/>
            <CheckBox x:Name="hasTestFilter" Content="Только с испытаниями" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Применить" Click="ApplyFilters_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Сброс" Click="ClearFilters_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </WrapPanel>
        <DataGrid x:Name="batchesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="BatchesGrid_SelectionChanged"
                  RowBackground="{Binding ЛабораторныйСтатус, Converter={StaticResource StatusToColorConverter}}"
                  AlternatingRowBackground="#F9FAFB"
                  Width="Auto" ColumnWidth="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto"/>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding НомерПартии}" Width="Auto"/>
                <DataGridTextColumn Header="Номер партии поставщика" Binding="{Binding НомерПартииПоставщика}" Width="Auto"/>
                <DataGridTextColumn Header="Материал" Binding="{Binding Сырье.Наименование}" Width="Auto"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Сырье.Категория}" Width="Auto"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Поставщик}" Width="Auto"/>
                <DataGridTextColumn Header="Дата поступления" Binding="{Binding ДатаПоступления, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                <DataGridTextColumn Header="Кол-во, кг" Binding="{Binding Количество_кг}" Width="Auto"/>
                <DataGridTextColumn Header="Ед. изм." Binding="{Binding Сырье.ЕдиницаИзмерения}" Width="Auto"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding ЛабораторныйСтатус}" Width="Auto"/>
                <DataGridTextColumn Header="Есть испытание" Binding="{Binding HasTest}" Width="Auto"/>
                <DataGridTextColumn Header="Дата последнего испытания" Binding="{Binding LastTestDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>