<Window x:Class="AgroControl.Laboratory.Views.LabTestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторное испытание" Height="650" Width="550"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Тип испытания:" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="typeCombo" SelectedIndex="0">
            <ComboBoxItem Content="входной контроль"/>
            <ComboBoxItem Content="повторный анализ"/>
            <ComboBoxItem Content="контроль поставщика"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Text="Дата назначения:" VerticalAlignment="Center" Margin="0,8,0,8"/>
        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="datePicker" Margin="0,8,0,8"/>

        <TextBlock Grid.Row="2" Text="Исполнитель:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="executorCombo" DisplayMemberPath="ПолноеИмя" SelectedValuePath="ID"/>

        <TextBlock Grid.Row="3" Text="Приоритет:" VerticalAlignment="Center" Margin="0,8,0,8"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="priorityCombo" SelectedIndex="0" Margin="0,8,0,8">
            <ComboBoxItem Content="обычный"/>
            <ComboBoxItem Content="высокий"/>
            <ComboBoxItem Content="срочный"/>
        </ComboBox>

        <!-- Панель выбора партии (будем скрывать, если партия уже известна) -->
        <StackPanel x:Name="batchSelectionPanel" Grid.Row="4" Grid.ColumnSpan="2">
            <TextBlock Text="Тип партии:" VerticalAlignment="Center" Margin="0,8,0,8"/>
            <ComboBox x:Name="batchTypeCombo" SelectedIndex="0" Margin="0,8,0,8">
                <ComboBoxItem Content="Сырьё"/>
                <ComboBoxItem Content="Готовая продукция"/>
            </ComboBox>
            <TextBlock Text="Номер партии:" VerticalAlignment="Center" Margin="0,8,0,8"/>
            <ComboBox x:Name="batchCombo" DisplayMemberPath="НомерПартии" SelectedValuePath="ID" Margin="0,8,0,8"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="Параметр:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="paramBox"/>

        <TextBlock Grid.Row="7" Text="Норматив:" VerticalAlignment="Center" Margin="0,8,0,8"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="normBox" Margin="0,8,0,8"/>

        <TextBlock Grid.Row="8" Text="Измеренное значение:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="measuredBox"/>

        <TextBlock Grid.Row="9" Text="Единица измерения:" VerticalAlignment="Center" Margin="0,8,0,8"/>
        <TextBox Grid.Row="9" Grid.Column="1" x:Name="unitBox" Margin="0,8,0,8"/>

        <TextBlock Grid.Row="10" Text="Комментарий:" VerticalAlignment="Top"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="commentBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="Save_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>