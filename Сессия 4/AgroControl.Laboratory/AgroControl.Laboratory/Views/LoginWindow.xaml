<Window x:Class="AgroControl.Laboratory.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация (лаборатория)" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Логин"/>
        <TextBox x:Name="loginBox" Margin="0,5,0,10"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="passwordBox" Margin="0,5,0,10"/>
        <Image x:Name="captchaImage" Height="80" Width="200" Margin="0,0,0,5"/>
        <TextBlock Text="Введите код с картинки"/>
        <TextBox x:Name="captchaBox" Margin="0,5,0,10"/>
        <Button Content="Войти" Click="Login_Click" Height="40" Background="#2563EB" Foreground="White"/>
        <TextBlock x:Name="errorText" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>