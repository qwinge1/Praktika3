<UserControl x:Class="AgroControl.Operator.Views.ProgramPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка партии (строка 0) -->
        <Border Grid.Row="0" Background="#F3F4F6" Padding="10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Номер партии:" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="lblBatchNumber" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Продукт / Линия:" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="lblProductLine" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Статус / Текущий шаг:" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="lblStatusStep" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Text="Время начала / Отклонения:" FontSize="12" Foreground="#6B7280"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="lblStartTime" FontSize="14"/>
                        <TextBlock x:Name="lblDeviation" FontSize="14" Margin="10,0,0,0" Foreground="Red" Visibility="Collapsed" Text="⚠️"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель кнопок (строка 1) – только обновить и выпуск продукции -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,5">
            <Button Content="🔄 Обновить" Click="RefreshProgram_Click" Style="{StaticResource PrimaryButton}" Background="#3B82F6" Width="100" Margin="5,0"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
            <TextBlock Text="Количество продукции (кг):" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="txtProductQuantity" Width="120" TextAlignment="Center" Margin="0,0,10,0"/>
            
        </StackPanel>

        <!-- Основная область (строка 2) – без изменений -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список шагов -->
            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <ListBox x:Name="lstSteps" SelectionChanged="Step_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding НомерШага}" Width="30" FontWeight="Bold"/>
                                <TextBlock Text="{Binding НаименованиеШага}" Width="170" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding СтатусВыполнения}" Width="80" Foreground="Gray"/>
                                <TextBlock Text="⚠️" Visibility="{Binding Отклонение, Converter={StaticResource BooleanToVisibility}}" Foreground="Orange" ToolTip="Было отклонение"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Детали шага -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock x:Name="lblStepName" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblPlanTemp" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblPlanDuration" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblPlanPressure" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblInstruction" TextWrapping="Wrap" Margin="0,10,0,0" FontStyle="Italic"/>

                    <GroupBox Header="Фактические данные" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Температура (°C)"/>
                            <TextBox x:Name="txtActualTemp" Margin="0,2,0,10" MinWidth="150"/>
                            <TextBlock Text="Длительность (мин)"/>
                            <TextBox x:Name="txtActualDuration" Margin="0,2,0,10" MinWidth="150"/>
                            <TextBlock Text="Давление (атм)"/>
                            <TextBox x:Name="txtActualPressure" Margin="0,2,0,10" MinWidth="150"/>
                            <TextBlock Text="Комментарий"/>
                            <TextBox x:Name="txtComment" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,10"/>
                            <Button Content="Сохранить данные" Click="SaveActuals_Click" Margin="0,5" Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                        <Button x:Name="btnStart" Content="Начать шаг" Width="120" Margin="5" Click="StartStep_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="btnComplete" Content="Завершить шаг" Width="120" Margin="5" Click="CompleteStep_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>