<UserControl x:Class="AgroControl.Operator.Views.ActiveBatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Click="Refresh_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtSearch" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="Линия:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbLine" Width="80" Margin="0,0,10,0" SelectedIndex="0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="L-01"/>
                <ComboBoxItem Content="L-02"/>
            </ComboBox>
            <Button Content="Применить" Click="ApplyFilters_Click" Width="100" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Сброс" Click="ResetFilters_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </WrapPanel>

        <DataGrid x:Name="dgBatches" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="Batch_DoubleClick"
                  AlternatingRowBackground="#F9FAFB" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding НомерПартии}" Width="150" MinWidth="120"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding Продукт}" Width="200" MinWidth="150"/>
                <DataGridTextColumn Header="Линия" Binding="{Binding Линия}" Width="80" MinWidth="60"/>
                <DataGridTextColumn Header="Текущий шаг" Binding="{Binding ТекущийШаг}" Width="220" MinWidth="180"/>
                <DataGridTextColumn Header="Статус партии" Binding="{Binding СтатусПартии}" Width="120" MinWidth="100"/>
                <DataGridTextColumn Header="Статус шага" Binding="{Binding СтатусШага}" Width="100" MinWidth="80"/>
                <DataGridCheckBoxColumn Header="Предупреждения" Binding="{Binding ЕстьПредупреждения}" Width="100"/>
                <DataGridCheckBoxColumn Header="Критические" Binding="{Binding ЕстьКритическиеОтклонения}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>