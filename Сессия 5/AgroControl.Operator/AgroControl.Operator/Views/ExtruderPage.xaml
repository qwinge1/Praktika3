<UserControl x:Class="AgroControl.Operator.Views.ExtruderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Текущие показатели экструдера" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" CornerRadius="8" Background="White" MinWidth="400">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Температура зоны 1:" FontSize="14" Grid.Column="0" Margin="0,0,15,0"/>
                        <TextBlock x:Name="lblTemp1" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Температура зоны 2:" FontSize="14" Grid.Column="0" Margin="0,0,15,0"/>
                        <TextBlock x:Name="lblTemp2" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Давление:" FontSize="14" Grid.Column="0" Margin="0,0,15,0"/>
                        <TextBlock x:Name="lblPressure" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скорость шнека:" FontSize="14" Grid.Column="0" Margin="0,0,15,0"/>
                        <TextBlock x:Name="lblSpeed" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Текущая мощность:" FontSize="14" Grid.Column="0" Margin="0,0,15,0"/>
                        <TextBlock x:Name="lblPower" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>
                    <TextBlock x:Name="lblTime" FontSize="12" Foreground="Gray" Margin="0,20,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>