<Window x:Class="AgroControl.Operator.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аппаратчик — вход в систему" Height="350" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,-16">
        <StackPanel VerticalAlignment="Center" Height="291">
            <TextBlock Text="АгроКонтроль" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Модуль аппаратчика" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            
            <TextBlock Text="Логин" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="35" Margin="0,0,0,15"/>
            
            <TextBlock Text="Пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="35" Margin="0,0,0,15"/>
            
            <Button Content="Войти" Click="Login_Click" Height="40" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
            <TextBlock x:Name="lblError" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>