{
  "info": {
    "name": "AgroControl API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5173/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (tech.ivanov / Password123!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"Username\": \"tech.ivanov\", \"Password\": \"Password123!\"}"
            }
          }
        },
        {
          "name": "Register new user",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"Username\": \"operator.test\", \"Password\": \"Test123!\", \"FullName\": \"Тестов Оператор\", \"Role\": \"operator\", \"Email\": \"test@agrocontrol.ru\", \"Department\": \"Цех №1\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Batches (защищены)",
      "item": [
        {
          "name": "Get all batches",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Batches",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get active batches",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Batches/active",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Start batch (id=1)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Batches/1/start",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Start step (stepId=1)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Batches/steps/1/start",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Complete step (stepId=1)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Batches/steps/1/complete",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Quality Control",
      "item": [
        {
          "name": "Create test",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/QualityControl",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"ПартияПроизводстваID\": 1, \"ТипОбразца\": \"готовая продукция\", \"НаименованиеПараметра\": \"концентрация\", \"ИзмеренноеЗначение\": \"98.5\", \"НормативноеЗначение\": \"97\", \"ЕдиницаИзмерения\": \"%\"}"
            }
          }
        },
        {
          "name": "Make decision (approve batch 1)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/QualityControl/1/decision",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"Decision\": \"одобрено\", \"Comment\": \"Соответствует норме\"}"
            }
          }
        }
      ]
    }
  ]
}