          }
        }
      ]
    },
    {
      "name": "6. Производственные партии",
      "item": [
        {
          "name": "Все партии",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Batches",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Активные партии",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Batches/active",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Запустить партию",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Batches/1/start",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Начать шаг",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Batches/steps/1/start",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Завершить шаг",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Batches/steps/1/complete",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Ввести фактические данные шага",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/Batches/steps/1/actuals",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"ActualTemp\": 45.5, \"ActualDuration\": 32, \"ActualPressure\": 1.6, \"Comment\": \"OK\"}"
