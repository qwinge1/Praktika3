{
  "info": {
    "name": "AgroControl API – полная",
    "description": "Коллекция для тестирования API системы управления производством СЗР.\n\nПеред использованием:\n1. Выполните Login.\n2. Токен автоматически сохранится в переменную {{token}}.\n3. Защищённые запросы используют Bearer-аутентификацию.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5173/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"Username\": \"test.user\", \"Password\": \"Test123!\"}"
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/Auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"Username\": \"new.operator\", \"Password\": \"Test123!\", \"FullName\": \"Новый Оператор\", \"Role\": \"operator\", \"Email\": \"newop@agrocontrol.ru\", \"Department\": \"Цех №2\"}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Справочники",
      "item": [
        {
          "name": "Products – список",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Products"
          }
        },
        {
          "name": "Products – по ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Products/1"
          }
        },
        {
          "name": "Products – архивировать",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/Products/2/archive"
          }
        },
        {
          "name": "Materials – список",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Materials"
          }
        },
        {
          "name": "Materials – по ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Materials/1"
          }
        },
        {
          "name": "Equipment – список",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Equipment"
          }
        },
        {
          "name": "Equipment – по ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Equipment/1"
          }
        },
        {
          "name": "Users – список",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Users"
          }
        },
        {
          "name": "Users – по ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/Users/1"
          }
        }
      ]
    },
    {
      "name": "3. Производственные заказы",
      "item": [
