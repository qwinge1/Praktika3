            "url": "{{base_url}}/ProductionOrders",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"НомерЗаказа\": \"PO-2421\", \"ПродуктID\": 1, \"РецептID\": 1, \"ТехКартаID\": 1, \"ПланКоличество_кг\": 1500, \"Статус\": \"черновик\", \"ПланДатаСтарта\": \"2026-05-10\"}"
            }
