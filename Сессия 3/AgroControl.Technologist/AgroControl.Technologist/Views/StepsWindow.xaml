<Window x:Class="AgroControl.Technologist.Views.StepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаги техкарты" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="stepNameBox" Width="120"/>
            <TextBlock Text="Темп.,°C:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="tempBox" Width="60"/>
            <TextBlock Text="Длит.,мин:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="durationBox" Width="60"/>
            <TextBlock Text="Давл.,бар:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="pressureBox" Width="60"/>
            <CheckBox x:Name="mandatoryCheck" Content="Обязат." VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="Добавить" Click="AddStep_Click" Style="{StaticResource PrimaryButton}" Width="80" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="stepsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>