<Window x:Class="AgroControl.Technologist.Views.TechCardEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Технологическая карта" Height="250" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Продукт:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Column="1" x:Name="productCombo" DisplayMemberPath="Наименование" SelectedValuePath="ID"/>

        <TextBlock Grid.Row="1" Text="Версия:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="versionBox"/>

        <TextBlock Grid.Row="2" Text="Статус:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="statusCombo">
            <ComboBoxItem Content="черновик"/>
            <ComboBoxItem Content="активна"/>
            <ComboBoxItem Content="архив"/>
        </ComboBox>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="Save_Click" Width="75" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="75" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>