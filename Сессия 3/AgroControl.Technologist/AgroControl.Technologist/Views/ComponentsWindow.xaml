<Window x:Class="AgroControl.Technologist.Views.ComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав рецептуры" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Материал:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="materialCombo" Width="150" DisplayMemberPath="Наименование"/>
            <TextBlock Text="Доля, %:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="percentageBox" Width="60"/>
            <TextBlock Text="Порядок:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="orderBox" Width="50"/>
            <Button Content="Добавить" Click="AddComponent_Click" Style="{StaticResource PrimaryButton}" Width="80" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="componentsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>