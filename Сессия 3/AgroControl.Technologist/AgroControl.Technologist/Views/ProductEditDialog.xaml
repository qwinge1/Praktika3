<Window x:Class="AgroControl.Technologist.Views.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продукт" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Код:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Column="1" x:Name="codeBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Text="Наименование:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="nameBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" Text="Тип:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="typeBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="3" Text="Форма выпуска:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="formBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="4" Text="Статус:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="statusCombo" SelectedIndex="0">
            <ComboBoxItem Content="черновик"/>
            <ComboBoxItem Content="активен"/>
            <ComboBoxItem Content="архив"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="Save_Click" Width="75" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="75" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>