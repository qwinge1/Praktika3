<Window x:Class="AgroControl.Technologist.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F9FAFB"
        >
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <Image x:Name="captchaImage" Height="80" Width="200" Margin="0,0,0,10"/>
            <TextBlock Text="Логин" Margin="0,5,0,0" Foreground="#4B5563"/>
            <TextBox x:Name="loginBox" FontSize="16" Margin="0,0,0,5"/>
            <TextBlock Text="Пароль" Margin="0,5,0,0" Foreground="#4B5563"/>
            <PasswordBox x:Name="passwordBox" FontSize="16" Margin="0,0,0,5"/>
            <TextBlock Text="Введите капчу" Margin="0,5,0,0" Foreground="#4B5563"/>
            <TextBox x:Name="captchaBox" FontSize="16" Margin="0,0,0,5"/>
            <Button Content="Войти" Click="LoginButton_Click" Height="40" FontSize="16" Margin="0,10"
                    Background="#2563EB" Foreground="White"/>
            <TextBlock x:Name="errorText" Foreground="Red" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>