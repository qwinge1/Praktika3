<UserControl x:Class="AgroControl.Technologist.Views.DeviationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Content="Обновить" Click="Refresh_Click" Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="searchBox" Width="200"/>
            <Button Content="Искать" Click="Search_Click" Style="{StaticResource PrimaryButton}" Width="80" Margin="6,0,0,0"/>
            <Button Content="Сброс" Click="ClearSearch_Click" Style="{StaticResource PrimaryButton}" Width="80" Margin="6,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="dataGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</UserControl>