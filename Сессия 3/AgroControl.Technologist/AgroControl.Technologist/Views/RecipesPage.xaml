<UserControl x:Class="AgroControl.Technologist.Views.RecipesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Click="Refresh_Click" Style="{StaticResource PrimaryButton}" Width="100"/>
            <Button Content="Добавить" Click="Add_Click" Style="{StaticResource PrimaryButton}" Width="100" Background="#10B981"/>
            <Button Content="Редактировать" Click="Edit_Click" Style="{StaticResource PrimaryButton}" Width="120" Background="#F59E0B"/>
            <Button Content="Архивировать" Click="Archive_Click" Style="{StaticResource PrimaryButton}" Width="120" Background="#EF4444"/>
            <Button Content="Удалить" Click="Delete_Click" Style="{StaticResource PrimaryButton}" Width="100" Background="#DC2626"/>
            <Button Content="Состав" Click="ShowComponents_Click" Style="{StaticResource PrimaryButton}" Width="100" Background="#8B5CF6"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="searchBox" Width="200"/>
            <Button Content="Искать" Click="Search_Click" Style="{StaticResource PrimaryButton}" Width="80" Margin="6,0,0,0"/>
            <Button Content="Сброс" Click="ClearSearch_Click" Style="{StaticResource PrimaryButton}" Width="80" Margin="6,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="dataGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</UserControl>