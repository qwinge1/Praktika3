<UserControl x:Class="AgroControl.Technologist.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Обзор производства" FontSize="24" FontWeight="Bold"
                   Foreground="#1F2937" Margin="0,0,0,16"/>

        <UniformGrid Columns="4" Grid.Row="0" Margin="0,0,0,24">
            <Border Background="White" CornerRadius="8" Margin="6,45,6,6" Padding="12"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Активные продукты" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                    <TextBlock x:Name="activeProductsText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="#2563EB" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="8,45,6,6" Padding="12"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Действующих рецептур" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                    <TextBlock x:Name="activeRecipesText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="#10B981" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6,45,6,6" Padding="12"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Партий в работе" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                    <TextBlock x:Name="batchesInProgressText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="#F59E0B" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6,45,6,6" Padding="12"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="С отклонениями" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                    <TextBlock x:Name="batchesWithDeviationsText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="#EF4444" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6" Padding="12"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Ожидают лаб. решения" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                    <TextBlock x:Name="pendingLabText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="#8B5CF6" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Последние события" FontSize="16" FontWeight="SemiBold"
                           Foreground="#1F2937" Margin="0,0,0,8"/>
                <TextBlock Text="· Партия B-2401-01 завершена (14:30)" Foreground="#4B5563" Margin="0,0,0,4"/>
                <TextBlock Text="· Лабораторная блокировка: партия B-2401-02" Foreground="#EF4444" Margin="0,0,0,4"/>
                <TextBlock Text="· Запуск партии B-2404-01" Foreground="#10B981"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>