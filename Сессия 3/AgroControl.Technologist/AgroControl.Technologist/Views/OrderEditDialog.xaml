<Window x:Class="AgroControl.Technologist.Views.OrderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Производственный заказ" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Номер заказа:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Column="1" x:Name="orderNumberBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Text="Продукт:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="productCombo" DisplayMemberPath="Наименование" SelectedValuePath="ID"/>

        <TextBlock Grid.Row="2" Text="Рецепт:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="recipeCombo" DisplayMemberPath="Версия" SelectedValuePath="ID"/>

        <TextBlock Grid.Row="3" Text="Тех. карта:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="techCardCombo" DisplayMemberPath="Версия" SelectedValuePath="ID"/>

        <TextBlock Grid.Row="4" Text="Количество (кг):" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="quantityBox" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="5" Text="Статус:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="statusCombo">
            <ComboBoxItem Content="запланирован"/>
            <ComboBoxItem Content="выполняется"/>
            <ComboBoxItem Content="завершен"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Text="План. дата старта:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="6" Grid.Column="1" x:Name="plannedDatePicker"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="Save_Click" Width="75" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="75" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>